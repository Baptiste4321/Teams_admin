<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 10.0.22621.0 gives access to WinRT Windows.Graphics.Capture, while supporting Windows 10 19041+ -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingCapture.Core\MeetingCapture.Core.csproj" />
    <ProjectReference Include="..\MeetingCapture.Synchronization\MeetingCapture.Synchronization.csproj" />
  </ItemGroup>

</Project>
