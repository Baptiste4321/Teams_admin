<Window x:Class="MeetingCapture.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres de Capture — Meeting Capture Studio"
        Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        Foreground="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Bouton fermer barre d'en-tête -->
        <Style x:Key="SettingsCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252A3D"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox moderne pour Settings -->
        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#171A26"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2A2F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#171A26"
                                                BorderBrush="#2A2F45"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="#94A3B8"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                                                <Setter TargetName="Border" Property="Background" Value="#1E2233"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="true"
                                   Focusable="false"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#151722"
                                        BorderBrush="#313752"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.65" ShadowDepth="6"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style CheckBox moderne -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Main Container Frameless avec ombre portée -->
    <Border CornerRadius="16" Background="#10121A" BorderBrush="#252A3D" BorderThickness="1.2"
            Margin="12" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.75" ShadowDepth="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header (Draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#6366F1" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#6366F1" Opacity="0.9" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="Paramètres de Capture" Foreground="#F8FAFC" FontWeight="Bold" FontSize="17"/>
                        <Border Background="#1C1F2E" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CONFIGURATION" Foreground="#818CF8" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Flux audio isolés, ciblage vidéo, cadence et périphériques" Foreground="#94A3B8" FontSize="11" Margin="20,2,0,0"/>
                </StackPanel>

                <!-- Bouton fermer fenêtre -->
                <Button Grid.Column="1" Click="CloseButton_Click" ToolTip="Fermer les paramètres"
                        Style="{StaticResource SettingsCloseBtn}" VerticalAlignment="Top">
                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Scrollable Settings Sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel Orientation="Vertical">

                    <!-- Section 1 : Information de session & Titre -->
                    <Border Background="#141724" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#222638" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SESSION" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                            <TextBlock Text="Titre par défaut de la réunion" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,6" FontSize="11"
                                     ToolTip="Titre personnalisé pour vos prochaines réunions"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 2 : Source Vidéo & Cadrage -->
                    <Border Background="#141724" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#222638" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="SOURCE VIDÉO &amp; CADRAGE" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/>

                            <!-- Fenêtre cible -->
                            <TextBlock Text="Fenêtre cible (Microsoft Teams / Navigateur / Application)" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                                      Style="{StaticResource SettingsComboBox}" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ProcessName}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" MaxWidth="380" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox IsChecked="{Binding IsDesktopCapture}" Content="Capturer tout le bureau (ignorer le cadrage fenêtre spécifique)"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>

                            <!-- Écran si mode bureau -->
                            <TextBlock Text="Écran à capturer (si mode plein bureau actif)" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                                      Style="{StaticResource SettingsComboBox}"
                                      DisplayMemberPath="DeviceName" Margin="0,0,0,10"/>

                            <!-- Cadence FPS -->
                            <TextBlock Text="Cadence d'images (FPS)" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}"
                                      Style="{StaticResource SettingsComboBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 3 : Note explicative Audio Isolé Process Loopback -->
                    <Border Background="#161928" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#3730A3" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🎧 " FontSize="13"/>
                                <TextBlock Text="Capture Audio Dédiée (Process Loopback)" Foreground="#818CF8" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="Le flux audio est extrait directement du processus applicatif Teams / Navigateur. Vos interlocuteurs sont enregistrés avec une clarté optimale même si vos haut-parleurs physiques sont éteints, coupés ou muets. Les bruits de fond et alertes Windows sont automatiquement ignorés."
                                       Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Section 4 : Sorties et Microphone -->
                    <Border Background="#141724" CornerRadius="10" Padding="14" Margin="0,0,0,6" BorderBrush="#222638" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="PÉRIPHÉRIQUES AUDIO &amp; MICROPHONE" Foreground="#64748B" FontWeight="Bold" FontSize="10" Margin="0,0,0,8"/>

                            <TextBlock Text="Périphérique de sortie de secours (si flux applicatif indisponible)" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                      Style="{StaticResource SettingsComboBox}"
                                      DisplayMemberPath="Name" Margin="0,0,0,12"/>

                            <CheckBox IsChecked="{Binding IsMicEnabled}" Content="Inclure mon microphone local (Désactivé = voix entrantes seules)"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Microphone local" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                      Style="{StaticResource SettingsComboBox}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions Bar -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="0">
                <Button Content="Enregistrer et Fermer" Click="CloseButton_Click"
                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"
                        BorderThickness="0" Padding="20,10" HorizontalAlignment="Right" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#4338CA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
