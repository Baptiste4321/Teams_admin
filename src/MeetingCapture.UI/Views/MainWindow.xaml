<Window x:Class="MeetingCapture.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Meeting Capture"
        Height="Auto" Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop, Mode=TwoWay}"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Left="80" Top="80">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Animation pulsation REC halo -->
        <Storyboard x:Key="RecPulsingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecGlowCircle"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:0.75"/>
            <DoubleAnimation Storyboard.TargetName="RecGlowCircle"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.9" To="1.25" Duration="0:0:0.75"/>
            <DoubleAnimation Storyboard.TargetName="RecGlowCircle"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.9" To="1.25" Duration="0:0:0.75"/>
        </Storyboard>

        <!-- Style bouton barre de titre -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252A3D"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style bouton close -->
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style combobox moderne pour MainWindow -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#171A26"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2A2F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#171A26"
                                                BorderBrush="#2A2F45"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="#94A3B8"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#4F46E5"/>
                                                <Setter TargetName="Border" Property="Background" Value="#1E2233"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="true"
                                   Focusable="false"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#151722"
                                        BorderBrush="#313752"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.6" ShadowDepth="6"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#10121A" BorderBrush="#252A3D" BorderThickness="1.2"
            Margin="12" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Color="#000000" Opacity="0.75" ShadowDepth="8"/>
        </Border.Effect>

        <StackPanel Orientation="Vertical">
            <!-- Header bar (Draggable & Minimaliste) -->
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Indicator & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#6366F1" Margin="2,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#6366F1" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="MeetingCapture" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                    <Border Background="#1C1F2E" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" Foreground="#818CF8" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Épingler au premier plan (Activer/Désactiver Always-On-Top)"
                            Command="{Binding ToggleAlwaysOnTopCommand}"
                            Style="{StaticResource TitleBarBtn}" Margin="0,0,2,0">
                        <TextBlock Text="📌" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="True">
                                            <Setter Property="Foreground" Value="#818CF8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAlwaysOnTop}" Value="False">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button ToolTip="Paramètres de capture" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource TitleBarBtn}" Margin="0,0,2,0">
                        <TextBlock Text="⚙" FontSize="13"/>
                    </Button>
                    <Button ToolTip="Historique des réunions" Command="{Binding OpenHistoryCommand}"
                            Style="{StaticResource TitleBarBtn}" Margin="0,0,2,0">
                        <TextBlock Text="📂" FontSize="13"/>
                    </Button>
                    <Button ToolTip="Réduire" Click="MinimizeButton_Click"
                            Style="{StaticResource TitleBarBtn}" Margin="0,0,2,0">
                        <TextBlock Text="─" FontSize="11" FontWeight="Bold"/>
                    </Button>
                    <Button ToolTip="Quitter" Click="CloseButton_Click"
                            Style="{StaticResource TitleBarCloseBtn}">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Meeting Title Input Bar -->
            <Border Background="#151722" CornerRadius="10" Padding="10,6" Margin="0,0,0,8" BorderBrush="#232738" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="✏️ Titre" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNotRecording}"
                             FontSize="11" Padding="8,4"
                             ToolTip="Saisissez un titre personnalisé ou laissez vide pour détection automatique"/>
                </Grid>
            </Border>

            <!-- Target Window Selector Bar (Moderne avec contraste parfait) -->
            <Border Background="#151722" CornerRadius="10" Padding="10,6" Margin="0,0,0,10" BorderBrush="#232738" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="🎯 Cible" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                              Height="28" Style="{StaticResource ModernComboBox}"
                              VerticalContentAlignment="Center" ToolTip="{Binding SelectedWindow.Title}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" MaxWidth="260" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2" Command="{Binding RefreshSourcesCommand}"
                            ToolTip="Actualiser les fenêtres détectées"
                            Width="28" Height="28" Cursor="Hand" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="#222536" Foreground="#CBD5E1" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="🔄" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBd" Property="Background" Value="#31364D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Control Bar (Bouton REC Studio + Chrono) -->
            <Border Background="#141724" CornerRadius="12" Padding="12,10" Margin="0,0,0,10" BorderBrush="#222638" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- REC / STOP Studio Button -->
                    <Button Grid.Column="0" Command="{Binding ToggleRecordCommand}"
                            Width="110" Height="40" Cursor="Hand"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="10" Name="BtnBorder">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- En veille (Prêt à enregistrer) -->
                                                <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                                    <Setter TargetName="BtnBorder" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#E11D48" Offset="0"/>
                                                                <GradientStop Color="#BE123C" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="BtnBorder" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="12" Color="#E11D48" Opacity="0.45" ShadowDepth="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <!-- En cours d'enregistrement (STOP) -->
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#292D3F"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#EF4444"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                        <!-- Button Content -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pulsing Dot -->
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Ellipse x:Name="RecGlowCircle" Width="14" Height="14" Fill="#EF4444"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="REC" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                       Visibility="{Binding IsNotRecording, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="STOP" Foreground="#EF4444" FontWeight="Bold" FontSize="13"
                                       Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Button>

                    <!-- Middle: Time & Status Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedTimeText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="17" FontFamily="Consolas, Segoe UI Variable Display"/>
                            
                            <!-- Badge LIVE clignotant / présent -->
                            <Border CornerRadius="4" Background="#3B1219" BorderBrush="#7F1D1D" BorderThickness="1"
                                    Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,4,0"/>
                                    <TextBlock Text="LIVE" Foreground="#FCA5A5" FontWeight="Bold" FontSize="9"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Right: Toggle Drawer -->
                    <Button Grid.Column="2" Command="{Binding ToggleDetailsCommand}"
                            ToolTip="Afficher / Masquer la transcription"
                            Background="#1E2235" Foreground="#CBD5E1" BorderThickness="0"
                            Width="30" Height="30" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="toggleBd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="▼" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="toggleBd" Property="Background" Value="#2D334D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Real-time Status Badges & VU-Meters (Console Audio Pro) -->
            <Border Background="#141724" CornerRadius="10" Padding="10,8" BorderBrush="#222638" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Indicators Bar -->
                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                        <!-- Video Badge -->
                        <Border Background="#1A1E2E" CornerRadius="6" Padding="6,4" Margin="2,0" BorderBrush="#24293E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🎥 " FontSize="10"/>
                                <TextBlock Text="{Binding VideoFps, StringFormat='{}{0:F0} FPS'}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Badge -->
                        <Border Background="#1A1E2E" CornerRadius="6" Padding="6,4" Margin="2,0" BorderBrush="#24293E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🎧 " FontSize="10"/>
                                <TextBlock Text="ISOLÉ" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Transcript Badge -->
                        <Border Background="#1A1E2E" CornerRadius="6" Padding="6,4" Margin="2,0" BorderBrush="#24293E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🎙️ " FontSize="10"/>
                                <TextBlock Text="{Binding TranscriptCount, StringFormat='{}{0} seg'}" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Chat Badge -->
                        <Border Background="#1A1E2E" CornerRadius="6" Padding="6,4" Margin="2,0" BorderBrush="#24293E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💬 " FontSize="10"/>
                                <TextBlock Text="{Binding ChatCount, StringFormat='{}{0} msg'}" Foreground="#C084FC" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Real Audio VU-Meters -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- System Audio VU (App loopback) -->
                        <TextBlock Grid.Column="0" Text="FLUX" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Value="{Binding SystemAudioLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="5"
                                     Foreground="#10B981" Background="#1E2333" BorderThickness="0" Margin="0,0,14,0"/>

                        <!-- Mic VU -->
                        <TextBlock Grid.Column="2" Text="MIC" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="3" Value="{Binding MicAudioLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="5"
                                     Foreground="#06B6D4" Background="#1E2333" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Expandable Transcription Stream -->
            <Border Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}"
                    Background="#141724" CornerRadius="10" Padding="12,10" Margin="0,8,0,0"
                    BorderBrush="#222638" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Transcription Whisper" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedWindow.Title, FallbackValue='Bureau complet'}"
                                   Foreground="#64748B" FontSize="10" HorizontalAlignment="Right" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Placeholder quand aucun segment en direct -->
                            <TextBlock Text="✨ La transcription complète sera générée automatiquement par Whisper dès l'arrêt de l'enregistrement."
                                       Foreground="#64748B" FontStyle="Italic" FontSize="11"
                                       TextWrapping="Wrap" Padding="4,8"
                                       Visibility="{Binding IsNotRecording, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding RecentTranscripts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C2030" CornerRadius="6" Padding="8,5" Margin="0,2" BorderBrush="#252A3E" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Speaker, StringFormat='[{0}] '}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#F1F5F9" FontSize="11" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
